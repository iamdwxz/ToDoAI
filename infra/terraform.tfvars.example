# Copy this file to terraform.tfvars and adjust values before running Terraform.
aws_region = "eu-central-1"

project_name = "todoai"
environment  = "dev"

# Existing ECR repository and image tag. Terraform only reads them.
ecr_repository_name = "todoai"
image_tag           = "1.0"

# Compute and scaling configuration.
instance_type          = "t3.micro"
asg_min_size           = 1
asg_desired_capacity   = 1
asg_max_size           = 2
cpu_target_utilization = 60

# Public domain and DNS.
domain_name         = "todoaidb.pp.ua"
create_route53_zone = true

# Keep false until the Route 53 hosted zone nameservers are delegated at the
# pp.ua DNS provider. Then set true to create and validate the ACM certificate,
# add the HTTPS listener, and enable port 443.
enable_https = false
